// Synthetic test: five distinct deployments should trigger.
// The PolicyDeployment record must be excluded.
let SyntheticEvents = datatable(
    TimeGenerated: datetime,
    Caller: string,
    SubscriptionId: string,
    DeploymentEntity: string
)
[
    datetime(2026-11-02 10:00:00), "test-caller", "test-sub", "/deployments/deploy-001",
    datetime(2026-11-02 10:01:00), "test-caller", "test-sub", "/deployments/deploy-002",
    datetime(2026-11-02 10:02:00), "test-caller", "test-sub", "/deployments/deploy-003",
    datetime(2026-11-02 10:03:00), "test-caller", "test-sub", "/deployments/deploy-004",
    datetime(2026-11-02 10:04:00), "test-caller", "test-sub", "/deployments/deploy-005",
    datetime(2026-11-02 10:04:30), "test-caller", "test-sub", "/deployments/PolicyDeployment_test"
];
let Deployments =
    SyntheticEvents
    | where DeploymentEntity !contains "PolicyDeployment_";
Deployments
| join kind=inner (
    Deployments
    | project
        Caller,
        SubscriptionId,
        CandidateTime = TimeGenerated,
        CandidateDeployment = DeploymentEntity
) on Caller, SubscriptionId
| where CandidateTime >= TimeGenerated
    and CandidateTime < TimeGenerated + 30m
| summarize
    DistinctDeployments = dcount(CandidateDeployment),
    DeploymentEntities = make_set(CandidateDeployment, 20)
    by TimeGenerated, Caller, SubscriptionId
| where DistinctDeployments >= 5
| project TimeGenerated, Caller, SubscriptionId, DistinctDeployments, DeploymentEntities
